<Window x:Class="SistemaInventario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventario Pro" Height="450" Width="600" WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6FA">

        <TabControl Margin="10" Background="White" BorderBrush="#DCDDE1" BorderThickness="1">

            <TabItem Header="➕ Agregar Producto" FontSize="14" Padding="10,5">
                <StackPanel Margin="30">
                    <TextBlock Text="NUEVO PRODUCTO" FontSize="20" FontWeight="Bold" Foreground="#2F3640" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Nombre del Producto:" Foreground="#353B48" FontWeight="SemiBold" FontSize="14"/>
                    <TextBox x:Name="txtNombreAgregar" Margin="0,5,0,15" Height="30" FontSize="14" Padding="5"/>

                    <TextBlock Text="Cantidad en Stock:" Foreground="#353B48" FontWeight="SemiBold" FontSize="14"/>
                    <TextBox x:Name="txtCantidadAgregar" Margin="0,5,0,25" Height="30" FontSize="14" Padding="5"/>

                    <Button Content="Guardar Producto" Height="40" Background="#4CD137" Foreground="White" FontWeight="Bold" FontSize="15" Click="BtnAgregar_Click" Cursor="Hand"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="📋 Ver Inventario" FontSize="14" Padding="10,5">
                <StackPanel Margin="20">
                    <TextBlock Text="INVENTARIO ACTUAL" FontSize="20" FontWeight="Bold" Foreground="#2F3640" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <ListBox x:Name="lstSoloLectura" Height="260" FontSize="15" Padding="10" Background="#F5F6FA" BorderBrush="#DCDDE1"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="⚙️ Gestionar" FontSize="14" Padding="10,5">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="1. Selecciona un producto:" FontWeight="Bold" Foreground="#353B48" Margin="0,0,0,10"/>
                        <ListBox x:Name="lstGestionar" Height="250" SelectionChanged="LstGestionar_SelectionChanged" FontSize="14" Background="#F5F6FA"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="2. Modifica o Elimina:" FontWeight="Bold" Foreground="#353B48" Margin="0,0,0,15"/>

                        <TextBlock Text="Nuevo Nombre:" Foreground="#353B48" FontSize="13"/>
                        <TextBox x:Name="txtNombreEditar" Margin="0,5,0,15" Height="30" FontSize="14" Padding="5"/>

                        <TextBlock Text="Nueva Cantidad:" Foreground="#353B48" FontSize="13"/>
                        <TextBox x:Name="txtCantidadEditar" Margin="0,5,0,20" Height="30" FontSize="14" Padding="5"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="✏️ Actualizar" Width="110" Height="35" Background="#FBC531" FontWeight="Bold" Margin="0,0,10,0" Click="BtnActualizar_Click" Cursor="Hand"/>
                            <Button Content="🗑️ Eliminar" Width="100" Height="35" Background="#E84118" Foreground="White" FontWeight="Bold" Click="BtnEliminar_Click" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>